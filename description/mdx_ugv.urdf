<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mdx_ugv">
  <xacro:include filename="$(find mdx_ugv)/description/inertial_macros.xacro"/>
  <!--
  wheel separation = 1.354m(0.677 + 0.677)
  wheel joint distances calculation in x coordinate
  rear_wheel in x = (2.33/2)-0.320 = -0.845m (rear wheel placement from the rear end of the chassis = 0.320m)
  center_wheel in x = (2.33/2)-(0.320+0.680) = -0.165m
  front_wheel in x = (2.33/2)-0.650 = 0.515m (front wheel placement from the front end of the chassis = 0.625m)
  lidar vertical angle set -30 to 30 degree
  lidar horizontal angle set as -90 to 90 degree
  -->

  <!-- <link name="base_footprint"/> 
  
  <joint name="base_link_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint> -->
  
  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.0 0.685" rpy="0.0 0.0 0.0"/>
      <geometry>
				<box size="${chassis_length} ${chassis_width} ${chassis_height}"/> 
      </geometry>
      <material name="Orange"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.685" rpy="0.0 0.0 0.0"/>
      <geometry>
				<box size="${chassis_length} ${chassis_width} ${chassis_height}"/> 
      </geometry>
    </collision>
    <inertial>
			<mass value="${chassis_mass}"/>
			<inertia ixx="1e-3" ixy="0.0" ixz="0.0" iyy="1e-3" iyz="0.0" izz="1e-3"/>
		</inertial>
  </link>

  <joint name="left_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_front_wheel"/>
    <axis xyz="0 0 1.0"/>
    <origin xyz="0.515 0.677 0.28" rpy="-1.57 0.0 0.0"/>
  </joint>

  <link name="left_front_wheel">
    <visual>
      <geometry>
				<cylinder length="${wheel_length}" radius="${wheel_radius}"/> 
      </geometry>
      <material name="Red"/>
    </visual>
    <collision>
      <geometry>
				<cylinder length="${wheel_length}" radius="${wheel_radius}"/> 
      </geometry>
    </collision>
    <xacro:inertial_cylinder wheel_mass="${wheel_mass}" wheel_length="${wheel_length}" wheel_radius="${wheel_radius}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="left_center_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_center_wheel"/>
    <axis xyz="0 0 1.0"/>
    <origin xyz="-0.165 0.677 0.28" rpy="-1.57 0.0 0.0"/>
  </joint>

  <link name="left_center_wheel">
    <visual>
      <geometry>
				<cylinder length="${wheel_length}" radius="${wheel_radius}"/> 
      </geometry>
      <material name="Red"/>
    </visual>
    <collision>
      <geometry>
				<cylinder length="${wheel_length}" radius="${wheel_radius}"/> 
      </geometry>
    </collision>
    <xacro:inertial_cylinder wheel_mass="${wheel_mass}" wheel_length="${wheel_length}" wheel_radius="${wheel_radius}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="left_rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_rear_wheel"/>
    <axis xyz="0 0 1.0"/>
    <origin xyz="-0.845 0.677 0.28" rpy="-1.57 0.0 0.0"/>
  </joint>

  <link name="left_rear_wheel">
    <visual>
      <geometry>
				<cylinder length="${wheel_length}" radius="${wheel_radius}"/> 
      </geometry>
      <material name="Red"/>
    </visual>
    <collision>
      <geometry>
				<cylinder length="${wheel_length}" radius="${wheel_radius}"/> 
      </geometry>
    </collision>
    <xacro:inertial_cylinder wheel_mass="${wheel_mass}" wheel_length="${wheel_length}" wheel_radius="${wheel_radius}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="right_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_front_wheel"/>
    <axis xyz="0.0 0.0 1.0"/>
    <origin xyz="0.515 -0.677 0.28" rpy="-1.57 0.0 0.0"/>
  </joint>

  <link name="right_front_wheel">
    <visual>
      <geometry>
				<cylinder length="${wheel_length}" radius="${wheel_radius}"/> 
      </geometry>
      <material name="Red"/>
    </visual>
    <collision>
      <geometry>
				<cylinder length="${wheel_length}" radius="${wheel_radius}"/> 
      </geometry>
    </collision>
    <xacro:inertial_cylinder wheel_mass="${wheel_mass}" wheel_length="${wheel_length}" wheel_radius="${wheel_radius}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="right_center_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_center_wheel"/>
    <axis xyz="0.0 0.0 1.0"/>
    <origin xyz="-0.165 -0.677 0.28" rpy="-1.57 0.0 0.0"/>
  </joint>

  <link name="right_center_wheel">
    <visual>
      <geometry>
				<cylinder length="${wheel_length}" radius="${wheel_radius}"/> 
      </geometry>
      <material name="Red"/>
    </visual>
    <collision>
      <geometry>
				<cylinder length="${wheel_length}" radius="${wheel_radius}"/> 
      </geometry>
    </collision>
    <xacro:inertial_cylinder wheel_mass="${wheel_mass}" wheel_length="${wheel_length}" wheel_radius="${wheel_radius}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="right_rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_rear_wheel"/>
    <axis xyz="0 0 1.0"/>
    <origin xyz="-0.845 -0.677 0.28" rpy="-1.57 0.0 0.0"/>
  </joint>

  <link name="right_rear_wheel">
    <visual>
      <geometry>
				<cylinder length="${wheel_length}" radius="${wheel_radius}"/> 
      </geometry>
      <material name="Red"/>
    </visual>
    <collision>
      <geometry>
				<cylinder length="${wheel_length}" radius="${wheel_radius}"/> 
      </geometry>
    </collision>
    <xacro:inertial_cylinder wheel_mass="${wheel_mass}" wheel_length="${wheel_length}" wheel_radius="${wheel_radius}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <axis xyz="0.0 0.0 1.0"/>
    <origin xyz="-1.02 0.0 1.59" rpy="0.0 -1.57 0.0"/>
  </joint>

  <link name="mast_link">
    <visual>
      <geometry>
				<box size="${mast_length} ${mast_width} ${mast_height}"/> 
      </geometry>
      <material name="Blue"/>
    </visual>
    <collision>
      <geometry>
				<box size="${mast_length} ${mast_width} ${mast_height}"/> 
      </geometry>
    </collision>
    <xacro:inertial_cylinder wheel_mass="${wheel_mass}" wheel_length="${wheel_length}" wheel_radius="${wheel_radius}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <link name="camera_link">
    <visual>  
      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}"/>
      </geometry>
      <material name="Red"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="1.165 0.0 0.76" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <!-- <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0.0 0.0 0.0" rpy="-1.57 0.0 -1.57"/>
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
  </joint>

  <link name="camera_link_optical"/> -->
  
  <gazebo reference="camera_link">
    <sensor type="camera" name="camera">
      <update_rate>10.0</update_rate>
      <camera name="head">
        <camera_info_topic>camera/camera_info</camera_info_topic>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>15.0</far>
          </clip>
      </camera>
      <topic>camera/image_raw</topic>
      <gz_frame_id>camera_link</gz_frame_id>
    </sensor>
  </gazebo>

  <link name="zed_camera_link">
    <visual>  
      <geometry>
        <box size="${zed_camera_length} ${zed_camera_width} ${zed_camera_height}"/>
      </geometry>
      <material name="Red"/>
    </visual>
  </link>

  <joint name="zed_camera_joint" type="fixed">
    <origin xyz="1.165 0.0 1.03" rpy="0 0.4 0"/>
    <parent link="base_link"/>
    <child link="zed_camera_link"/>
  </joint>

  <gazebo reference="zed_camera_link">
    <sensor type="rgbd_camera" name="zed_camera">
      <update_rate>10.0</update_rate>
      <visualize>true</visualize>
      <always_on>true</always_on>
      <camera>
        <camera_info_topic>zed_camera/camera_info</camera_info_topic>
        <horizontal_fov>1.5</horizontal_fov>
        <image>
          <width>420</width>
          <height>240</height>
          <!-- <format>B8G8R8</format> -->
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>5.0</far>
        </clip>
      </camera>
      <topic>zed_camera</topic>
      <gz_frame_id>zed_camera_link</gz_frame_id>
    </sensor>
  </gazebo>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
      </geometry>
      <material name="Red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <origin xyz="1.08 0 0.9" rpy="0 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
  </joint>

  <gazebo reference="lidar_link">
    <material>Gazebo/Red</material>
    <sensor name="block_laser_sensor" type="gpu_ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>30.0</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>0.5</resolution>
            <min_angle>-1.57</min_angle>
            <max_angle>1.57</max_angle>
          </horizontal>
          <vertical>
            <samples>32</samples>
            <resolution>0.5</resolution>
            <min_angle>-0.523599</min_angle>
            <max_angle>0.523599</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <point_cloud>true</point_cloud>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <topic>ouster_points</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
    </sensor>
  </gazebo>

  <joint name="gps_joint" type="fixed">
    <origin xyz="-1.02 0.0 2.1" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link = "gps_link"/>
  </joint>

  <link name="gps_link">
    <visual>  
      <geometry>
        <cylinder radius="${gps_radius}" length="${gps_length}"/>
      </geometry>
      <material name="Green"/>
    </visual>
  </link>

  <gazebo reference = "gps_link">
    <sensor name="navsat" type="navsat">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/navsat/fix</topic>
      <gz_frame_id>gps_link</gz_frame_id>
      <navsat>
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </vertical>
        </position_sensing>
      </navsat>
    </sensor>    
  </gazebo> 

  <link name="imu_link">
    <visual>
      <geometry>
        <box size="${imu_length} ${imu_width} ${imu_height}"/>
      </geometry>
      <material name="Green"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.68" rpy="0.0 0.0 0.0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>10.0</update_rate>
      <visualize>true</visualize>
      <gz_frame_id>imu_link</gz_frame_id>
      <topic>imu</topic>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- <ros2_control name="MDXUGVSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <xacro:macro name="wheel_joint" params="name">
      <joint name="${name}">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>

    <xacro:wheel_joint name="left_front_wheel_joint"/>
    <xacro:wheel_joint name="right_front_wheel_joint"/>
    <xacro:wheel_joint name="left_rear_wheel_joint"/>
    <xacro:wheel_joint name="right_rear_wheel_joint"/>
  </ros2_control> -->

  <gazebo>
    <plugin name='gz::sim::systems::DiffDrive' filename='gz-sim-diff-drive-system'>
      <!-- <left_joint>left_front_wheel_joint</left_joint>
      <right_joint>right_front_wheel_joint</right_joint> -->
      <left_joint>left_front_wheel_joint</left_joint>
      <left_joint>left_rear_wheel_joint</left_joint>
      <left_joint>left_center_wheel_joint</left_joint>
      <right_joint>right_center_wheel_joint</right_joint>
      <right_joint>right_front_wheel_joint</right_joint>
      <right_joint>right_rear_wheel_joint</right_joint>
      <wheel_separation>1.354</wheel_separation>
      <wheel_radius>0.280</wheel_radius>
      <max_linear_acceleration>10</max_linear_acceleration>
      <min_linear_acceleration>-10</min_linear_acceleration>
      <max_angular_acceleration>3.5</max_angular_acceleration>
      <min_angular_acceleration>-3.5</min_angular_acceleration>
      <max_linear_velocity>2.0</max_linear_velocity>
      <min_linear_velocity>-2.0</min_linear_velocity>
      <max_angular_velocity>5.0</max_angular_velocity>
      <min_angular_velocity>-5.0</min_angular_velocity>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_topic>odom</odom_topic>
      <odom_publisher_frequency>30</odom_publisher_frequency>
      <tf_topic>/tf</tf_topic>
      <topic>cmd_vel</topic>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>left_front_wheel_joint</joint_name>
      <joint_name>right_front_wheel_joint</joint_name>
      <joint_name>left_center_wheel_joint</joint_name>
      <joint_name>right_center_wheel_joint</joint_name>
      <joint_name>left_rear_wheel_joint</joint_name>
      <joint_name>right_rear_wheel_joint</joint_name>
      <update_rate>30</update_rate>
    </plugin>
  </gazebo>

  <gazebo reference = "base_link">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference = "left_front_wheel">
    <material>Gazebo/Red</material>
  </gazebo> 

  <gazebo reference = "left_center_wheel">
    <material>Gazebo/Red</material>
  </gazebo> 

  <gazebo reference = "left_rear_wheel">
    <material>Gazebo/Red</material>
  </gazebo> 

  <gazebo reference = "right_front_wheel">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference = "right_center_wheel">
    <material>Gazebo/Red</material>
  </gazebo>  

  <gazebo reference = "right_rear_wheel">
    <material>Gazebo/Red</material>
  </gazebo> 

  <gazebo reference = "mast_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference = "camera_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference = "lidar_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference = "imu_link">
    <material>Gazebo/Green</material>
  </gazebo>

  <gazebo reference = "gps_link">
    <material>Gazebo/Green</material>
  </gazebo>

</robot>
